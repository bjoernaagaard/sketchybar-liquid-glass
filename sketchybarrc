#!/bin/bash
# Before feature work, read AGENTS.md.
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
source "$CONFIG_DIR/theme.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"
# hover.sh records which system half is under the pointer, and spaces.sh marks a running retry chain.
# A restart can leave either behind.
rm -f "${TMPDIR:-/tmp}"/sketchybar-hover.system.*
rmdir "${TMPDIR:-/tmp}/sketchybar-spaces-retry" 2>/dev/null
"$PLUGIN_DIR/popup.sh" build || exit 1

# The bar is clear and its three pills float on every display. notch.sh sets notch_width, which SketchyBar
# uses only on a display with a notch.
a=(--bar position=top height=30 margin=8 y_offset=8 corner_radius=12 shadow=on padding_left=0 padding_right=0
    "${BAR_NOTCH[@]}" blur_radius=0 display=main topmost=window)

a+=(--default updates=when_shown
    icon.font="$FONT:Medium:13.0" label.font="$FONT:Semibold:13.0"
    icon.color=$TEXT2 label.color=$TEXT
    icon.padding_left=0 icon.padding_right=0 label.padding_left=0 label.padding_right=0
    padding_left=0 padding_right=0
    background.height=22 background.corner_radius=8 background.color=$CLEAR)

a+=(--add event aerospace_workspace_change
    --add event aerospace_focus_change
    --add event aerospace_mode_change
    --add event notch_change
    --add event volume_state
    --add event network_state
    --add event media_state
    --add event media_progress
    --add event tailscale_state
    --add event system_state)

gap() { a+=(--add item "$1" left --set "$1" width=$2); }

# AeroSpace can start after SketchyBar at login, so spaces.sh builds the workspace pills before mode.
a+=(--add item half.left.start left
    --set half.left.start width=4

    --add item mode left
    --set mode drawing=off updates=on padding_left=2 label.color=$TEXT label.padding_left=8 label.padding_right=8
               background.drawing=on background.color=$PILL script="$PLUGIN_DIR/status.sh" click_script="$PLUGIN_DIR/popup.sh mode"
    --subscribe mode aerospace_mode_change mouse.entered mouse.exited)

gap sep.l 6
a+=(--add item sep left
    --set sep width=1 background.drawing=on background.color=0x1fffffff background.height=14 background.corner_radius=0)
gap sep.r 4

a+=(--add item spaces left
    --set spaces drawing=off updates=on script="$PLUGIN_DIR/spaces.sh"
    --subscribe spaces aerospace_workspace_change aerospace_focus_change front_app_switched space_windows_change system_woke

    --add item front.icon left
    --set front.icon width=$APP_SLOT background.drawing=on background.image.scale=$ICON_SCALE script="$PLUGIN_DIR/hover.sh" click_script="$PLUGIN_DIR/popup.sh front.icon"
    --subscribe front.icon mouse.entered mouse.exited

    --add item front left
    --set front label.padding_left=4 label.padding_right=8 script="$PLUGIN_DIR/hover.sh" click_script="$PLUGIN_DIR/popup.sh front"
    --subscribe front mouse.entered mouse.exited

    --add item half.left.end left
    --set half.left.end width=4

    --add bracket half.left half.left.start half.left.end
    --set half.left "${PILL_STYLE[@]}"

    # The progress plate has no footprint: padding_left puts it ISLAND_GAP + PROGRESS_INSET after the left
    # island, where the media island starts plus its inset. status.sh sets label.width to the plate's width
    # and padding_right to cancel both, so the left island and the media island never see it.
    --add item media.progress left
    --set media.progress drawing=off updates=on padding_left=$((ISLAND_GAP + PROGRESS_INSET)) label.width=0
                         background.drawing=on background.color=$PROGRESS background.height=$PROGRESS_HEIGHT
                         background.corner_radius=$PROGRESS_RADIUS script="$PLUGIN_DIR/status.sh"
    --subscribe media.progress media_progress)

# right side is added right to left
# The resident helper pushes volume, media, network, tailscale, and system with <item>_state events.
# updates=on keeps a push from being dropped while an item is not shown.
a+=(--add item half.right.end right
    --set half.right.end width=4

    --add item clock right
    --set clock icon.color=$TEXT2 icon.font="$FONT:Medium:13.0" icon.padding_left=8 icon.padding_right=6 label.padding_right=8
                update_freq=10 script="$PLUGIN_DIR/status.sh" click_script="$PLUGIN_DIR/popup.sh clock"
    --subscribe clock system_woke mouse.entered mouse.exited

    --add item battery right
    --set battery icon.padding_left=8 icon.padding_right=6 label.color=$TEXT2 label.font="$FONT:Medium:13.0" label.padding_right=8
                  update_freq=120 script="$PLUGIN_DIR/status.sh" click_script="$PLUGIN_DIR/popup.sh battery"
    --subscribe battery power_source_change system_woke mouse.entered mouse.exited

    --add item notch center
    --set notch drawing=off updates=on script="$PLUGIN_DIR/notch.sh"
    --subscribe notch notch_change system_woke

    --add item bluetooth right
    --set bluetooth icon.padding_left=8 icon.padding_right=8 label.drawing=off script="$PLUGIN_DIR/status.sh"
                    click_script="$PLUGIN_DIR/popup.sh bluetooth"
    --subscribe bluetooth mouse.entered mouse.exited

    --add item network right
    --set network icon.padding_left=8 icon.padding_right=8 label.drawing=off updates=on script="$PLUGIN_DIR/status.sh"
                  click_script="$PLUGIN_DIR/popup.sh network"
    --subscribe network network_state mouse.entered mouse.exited

    --add item tailscale right
    --set tailscale icon.padding_left=8 icon.padding_right=8 label.drawing=off updates=on script="$PLUGIN_DIR/status.sh"
                    click_script="$PLUGIN_DIR/popup.sh tailscale"
    --subscribe tailscale tailscale_state mouse.entered mouse.exited

    --add item system.memory right
    --set system.memory icon.padding_left=5 icon.padding_right=6 label.color=$TEXT2 label.font="$FONT:Medium:13.0" label.padding_right=8
                        label.width=$MEMORY_LABEL_WIDTH updates=on script="$PLUGIN_DIR/status.sh" click_script="$PLUGIN_DIR/popup.sh system"
    --subscribe system.memory mouse.entered mouse.exited

    --add item system.cpu right
    --set system.cpu icon.padding_left=8 icon.padding_right=6 label.color=$TEXT2 label.font="$FONT:Medium:13.0" label.padding_right=5
                     label.width=$CPU_LABEL_WIDTH updates=on script="$PLUGIN_DIR/status.sh" click_script="$PLUGIN_DIR/popup.sh system"
    --subscribe system.cpu system_state mouse.entered mouse.exited

    --add item half.right.start right
    --set half.right.start width=4

    --add bracket half.right half.right.start half.right.end
    --set half.right "${PILL_STYLE[@]}"

    --add bracket system system.cpu system.memory
    --set system background.color=$CLEAR background.height=22 background.corner_radius=8)

# The media island sits in the q position, which SketchyBar fills leftward from the notch, or from the
# screen centre on a display without one. Items added first sit nearest the notch.
a+=(--add item notch.gap q
    --set notch.gap width=5

    --add item island.media.end q
    --set island.media.end width=4

    --add item volume q
    --set volume icon.padding_left=8 icon.padding_right=6 label.color=$TEXT2 label.font="$FONT:Medium:13.0" label.padding_right=8
                 label.width=$VOLUME_LABEL_WIDTH
                 updates=on script="$PLUGIN_DIR/status.sh" click_script="$PLUGIN_DIR/popup.sh volume"
    --subscribe volume volume_state mouse.scrolled mouse.entered mouse.exited

    --add item media.next q
    --set media.next icon.width=$MEDIA_CONTROL_WIDTH icon.align=center script="$PLUGIN_DIR/hover.sh"
                     click_script="$PLUGIN_DIR/popup.sh media-next"
    --subscribe media.next mouse.entered mouse.exited

    --add item media.toggle q
    --set media.toggle icon.width=$MEDIA_CONTROL_WIDTH icon.align=center script="$PLUGIN_DIR/hover.sh"
                       click_script="$PLUGIN_DIR/popup.sh media-toggle"
    --subscribe media.toggle mouse.entered mouse.exited

    --add item media.prev q
    --set media.prev icon.width=$MEDIA_CONTROL_WIDTH icon.align=center script="$PLUGIN_DIR/hover.sh"
                     click_script="$PLUGIN_DIR/popup.sh media-previous"
    --subscribe media.prev mouse.entered mouse.exited

    --add item media q
    --set media icon.padding_left=8 icon.padding_right=6 label.padding_right=8
                 updates=on script="$PLUGIN_DIR/status.sh" click_script="$PLUGIN_DIR/popup.sh media"
    --subscribe media media_state mouse.entered mouse.exited

    --add item island.media.start q
    --set island.media.start width=4

    --add bracket island.media island.media.start island.media.end
    --set island.media "${PILL_STYLE[@]}")

$SB "${a[@]}"
# The resident helper reports display changes.
"$PLUGIN_DIR/popup.sh" start
$SB --update
